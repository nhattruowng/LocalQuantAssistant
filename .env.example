# LocalQuant Assistant environment template.
# Copy to `.env` for local overrides. Do not commit real secrets.

LOCALQUANT_ENV=local
APP_CONFIG_PATH=src/config/settings.yaml
LOCALQUANT_DB_PATH=data/localquant.db
LOG_LEVEL=INFO
STREAMLIT_PORT=8501
API_PORT=8000
LOCALQUANT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Optional Docker user mapping. On Linux, set these to your host uid/gid
# so mounted data/, models/, and logs/ files are writable by your user.
LOCALQUANT_UID=1000
LOCALQUANT_GID=1000

# Optional Telegram alerts. Keep real values only in .env.
# Alert delivery is enabled/disabled from src/config/settings.yaml.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
